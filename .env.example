MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

# Optional email notification. Notifications are skipped when these are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Set this when the frontend and API are deployed on different origins.
VITE_API_URL=
